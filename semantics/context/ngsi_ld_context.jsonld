{
  "@context": {
    "@vocab": "https://sustainabilitydataspace.com/ontology#",
    "sds": "https://sustainabilitydataspace.com/ontology#",
    "dct": "http://purl.org/dc/terms/",
    "schema": "http://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "odrl": "http://www.w3.org/ns/odrl/2/",
    "esrs": "https://efrag.org/esrs#",
    "gri": "https://www.globalreporting.org/standards#",
    "ghg": "https://ghgprotocol.org/standards#",

    "Dataset": "sds:Dataset",
    "Indicator": "sds:Indicator",
    "Variable": "sds:Variable",
    "RelationshipAssertion": "sds:RelationshipAssertion",
    "CalculationContract": "sds:CalculationContract",
    "UnitConversionRule": "sds:UnitConversionRule",

    "hasIndicator": {"@id": "sds:hasIndicator", "@type": "@id"},
    "hasPolicy": {"@id": "odrl:hasPolicy", "@type": "@id"},
    "conformsTo": "dct:conformsTo",
    "dimension": "sds:dimension",
    "indicator": "sds:indicatorName",
    "codeESRS": "sds:codeESRS",
    "codeGRI": "sds:codeGRI",
    "codeGHG": "sds:codeGHG",
    "sourceStandard": "sds:sourceStandard",
    "standardVersion": "sds:standardVersion",
    "sourceIndicator": {"@id": "sds:sourceIndicator", "@type": "@id"},
    "targetIndicator": {"@id": "sds:targetIndicator", "@type": "@id"},
    "canonicalPivot": {"@id": "sds:canonicalPivot", "@type": "@id"},
    "relationshipType": "sds:relationshipType",
    "relationshipStatus": "sds:relationshipStatus",
    "activationStatus": "sds:activationStatus",
    "unitName": "sds:unitName",
    "unitType": "sds:unitType",
    "unitConversionPolicy": "sds:unitConversionPolicy",
    "conversionStatus": "sds:conversionStatus",
    "nonConvertible": {"@id": "sds:nonConvertible", "@type": "xsd:boolean"},
    "calculationStatus": "sds:calculationStatus",
    "formula": "sds:formula",
    "formulaLanguage": "sds:formulaLanguage",
    "componentRef": {"@id": "sds:componentRef", "@type": "@id"},
    "runtimeExternalInput": "sds:runtimeExternalInput",
    "valueBoundary": "sds:valueBoundary",
    "periodicity": "sds:periodicity",
    "sourceRef": "sds:sourceRef",
    "referenceDataSource": "sds:referenceDataSource",
    "evidencePath": "sds:evidencePath",
    "sourceRow": {"@id": "sds:sourceRow", "@type": "xsd:integer"},
    "purpose": "odrl:purpose",
    "spatialCoverage": "dct:spatial",
    "provider": "dct:publisher",
    "provenance": "dct:provenance",
    "owner": "dct:creator",
    "accessRights": "dct:accessRights",
    "validationMethod": "sds:validationMethod",

    "title": "dct:title",
    "description": "dct:description",
    "identifier": "dct:identifier",
    "effectiveFrom": {"@id": "sds:effectiveFrom", "@type": "xsd:date"},
    "effectiveTo": {"@id": "sds:effectiveTo", "@type": "xsd:date"},
    "issued": {"@id": "dct:issued", "@type": "xsd:date"},
    "modified": {"@id": "dct:modified", "@type": "xsd:date"}
  }
}
