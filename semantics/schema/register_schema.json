{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sustainabilitydataspace.com/schema/sds/register.schema.json",
  "title": "SDS Dataset Register Entry",
  "type": "object",
  "properties": {
    "identifier": {"type": "string"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "dimension": {"type": "string", "enum": ["Environmental", "Social", "Governance", "Transversal", "E", "S", "G", "T", ""]},
    "indicator": {"type": "string"},
    "sourceStandard": {"type": "string"},
    "standardVersion": {"type": "string"},
    "unitName": {"type": "string"},
    "unitType": {"type": "string"},
    "unitConversionPolicy": {"type": "string"},
    "conversionStatus": {"type": "string"},
    "nonConvertible": {"type": ["boolean", "string"]},
    "periodicity": {"type": "string"},
    "sourceRef": {"type": "string"},
    "referenceDataSource": {"type": "string"},
    "codeESRS": {"type": "string"},
    "codeGRI": {"type": "string"},
    "codeGHG": {"type": "string"},
    "sourceIndicator": {"type": "string"},
    "targetIndicator": {"type": "string"},
    "canonicalPivot": {"type": "string"},
    "relationshipType": {"type": "string"},
    "relationshipStatus": {"type": "string"},
    "activationStatus": {"type": "string"},
    "calculationStatus": {"type": "string"},
    "formula": {"type": "string"},
    "formulaLanguage": {"type": "string"},
    "componentRef": {"type": "string"},
    "runtimeExternalInput": {"type": "string"},
    "valueBoundary": {"type": "string"},
    "evidencePath": {"type": "string"},
    "sourceRow": {
      "oneOf": [
        {"type": "integer", "minimum": 1},
        {"type": "string", "pattern": "^\\d+$"}
      ]
    },
    "purpose": {"type": "string"},
    "spatialCoverage": {"type": "string"},
    "provider": {"type": "string"},
    "provenance": {"type": "string"},
    "effectiveFrom": {"type": "string", "format": "date"},
    "effectiveTo": {"type": "string", "format": "date"},
    "hasPolicy": {"type": "string"},
    "conformsTo": {"type": "string"},
    "owner": {"type": "string"},
    "accessRights": {"type": "string"},
    "validationMethod": {"type": "string"}
  },
  "required": ["identifier", "title", "dimension", "evidencePath", "sourceRow"],
  "additionalProperties": true
}
