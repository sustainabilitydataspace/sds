    <rdf:type rdf:resource="https://sustainabilitydataspace.com/ontology#Indicator"/>
    <skos:prefLabel xml:lang="en">Ratio of entry-level wage by gender at significant locations of operation to the local minimum wage</skos:prefLabel>
    <skos:definition xml:lang="en">When a significant proportion of employees are compensated based on wages subject to minimum wage rules, the organization reports the ratio of the entry-level wage by gender at significant locations of operation to the local minimum wage as a direct reportable ratio input. The breakdown by gender and significant location of operation is preserved through the dimension bindings; the disclosed value itself is the reported ratio.</skos:definition>
    <sds:hasUnit rdf:resource="Ratio"/>
    <sds:hasTemporalGranularity rdf:resource="https://sustainabilitydataspace.com/ontology#Annual"/>
