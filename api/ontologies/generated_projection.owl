    <skos:definition xml:lang="en">The approach to engagement with tax authorities, which can include participating in cooperative compliance agreements, seeking active real-time audit, seeking clearance for all significant transactions, engaging on tax risks, and seeking advance pricing agreements.</skos:definition>
    <sds:hasUnit rdf:resource="Text"/>
    <sds:hasTemporalGranularity rdf:resource="https://sustainabilitydataspace.com/ontology#Annual"/>
  </rdf:Description>
