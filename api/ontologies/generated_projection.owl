  <rdf:Description rdf:about="urn:sds:reg:gri:gri_2_19_a_i">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://sustainabilitydataspace.com/ontology#Indicator"/>
    <skos:prefLabel xml:lang="en">Remuneration policies for fixed pay and variable pay</skos:prefLabel>
    <skos:definition xml:lang="en">Describe remuneration policies for fixed pay and variable pay, which can include performance-based pay, equity-based pay, bonuses, and deferred and vested shares. If performance-based pay is used, describe how remuneration for senior executives is designed to reward long-term performance.</skos:definition>
    <sds:hasUnit rdf:resource="Text"/>
    <sds:hasTemporalGranularity rdf:resource="https://sustainabilitydataspace.com/ontology#Annual"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sds:reg:gri:gri_sf_11_6_2_303_1_a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://sustainabilitydataspace.com/ontology#Indicator"/>
    <skos:prefLabel xml:lang="en">Description of how the organization interacts with water and related impacts</skos:prefLabel>
    <skos:definition xml:lang="en">A description of how the organization interacts with water, including how and where water is withdrawn, consumed, and discharged, and the water-related impacts the organization has caused or contributed to, or that are directly linked to its operations, products, or services by its business relationships.</skos:definition>
    <sds:hasUnit rdf:resource="Text"/>
    <sds:hasTemporalGranularity rdf:resource="https://sustainabilitydataspace.com/ontology#Annual"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sds:reg:gri:gri_sf_11_5_5_306_4_c">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://sustainabilitydataspace.com/ontology#Indicator"/>
    <skos:prefLabel xml:lang="en">Non-hazardous waste diverted from disposal by recovery operation</skos:prefLabel>
    <skos:definition xml:lang="en">Total weight of non-hazardous waste diverted from disposal in metric tons, with breakdown by recovery operations preserved as classification context.</skos:definition>
    <sds:hasUnit rdf:resource="t"/>
    <sds:hasTemporalGranularity rdf:resource="https://sustainabilitydataspace.com/ontology#Annual"/>
  </rdf:Description>
