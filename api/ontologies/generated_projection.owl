  <rdf:Description rdf:about="urn:sds:reg:esrs:s1_2_02">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://sustainabilitydataspace.com/ontology#Indicator"/>
    <skos:prefLabel xml:lang="en">Engagement occurs with own workforce or their representatives</skos:prefLabel>
    <skos:definition xml:lang="en">Disclosure of the groups for which engagement occurs, i.e., directly with the undertaking's own workforce or with workers' representatives.</skos:definition>
    <sds:hasUnit rdf:resource="boolean"/>
    <sds:hasTemporalGranularity rdf:resource="https://sustainabilitydataspace.com/ontology#Annual"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sds:reg:gri:gri_101_2_a_iii">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://sustainabilitydataspace.com/ontology#Indicator"/>
    <skos:prefLabel xml:lang="en">Actions taken to restore and rehabilitate affected ecosystems, including the goals and how stakeholders are engaged</skos:prefLabel>
    <skos:definition xml:lang="en">Description of restoration and rehabilitation actions taken in areas affected by the organization's activities, including goals (proportional, viable, measurable), restoration/rehabilitation stages (planning and design; implementation; monitoring, documentation, evaluation, and reporting; ongoing activities and maintenance), targeted species and ecosystems, alignment with UN Decade on Ecosystem Restoration principles, stakeholder engagement (co-design, co-management, co-governance), and FPIC for Indigenous Peoples and local communities.</skos:definition>
    <sds:hasUnit rdf:resource="Text"/>
    <sds:hasTemporalGranularity rdf:resource="https://sustainabilitydataspace.com/ontology#Annual"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sds:reg:gri:gri_207_2_a_ii">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://sustainabilitydataspace.com/ontology#Indicator"/>
    <skos:prefLabel xml:lang="en">How the approach to tax is embedded within the organization</skos:prefLabel>
    <skos:definition xml:lang="en">How the approach to tax is embedded within the organization, including processes, projects, programs, and initiatives that support adherence to the approach to tax and tax strategy.</skos:definition>
    <sds:hasUnit rdf:resource="Text"/>
    <sds:hasTemporalGranularity rdf:resource="https://sustainabilitydataspace.com/ontology#Annual"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sds:reg:gri:gri_sf_13_15_1_3_3_e_iii">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://sustainabilitydataspace.com/ontology#Indicator"/>
    <skos:prefLabel xml:lang="en">Effectiveness of the actions, including progress toward goals and targets for soil management</skos:prefLabel>
    <skos:definition xml:lang="en">Effectiveness of the actions, including progress toward goals and targets for soil management</skos:definition>
    <sds:hasUnit rdf:resource="Text"/>
    <sds:hasTemporalGranularity rdf:resource="https://sustainabilitydataspace.com/ontology#Annual"/>
  </rdf:Description>
  <rdf:Description rdf:about="urn:sds:reg:gri:gri_2_9_c_ii">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://sustainabilitydataspace.com/ontology#Indicator"/>
    <skos:prefLabel xml:lang="en">Composition by independence</skos:prefLabel>
    <skos:definition xml:lang="en">Describe the composition of the highest governance body and its committees by independence. 'Independence' refers to conditions that enable the members of the highest governance body to exercise independent judgment free from any external influence or conflicts of interest.</skos:definition>
    <sds:hasUnit rdf:resource="Text"/>
    <sds:hasTemporalGranularity rdf:resource="https://sustainabilitydataspace.com/ontology#Annual"/>
  </rdf:Description>
