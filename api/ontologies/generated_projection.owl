    <rdf:type rdf:resource="https://sustainabilitydataspace.com/ontology#Indicator"/>
    <skos:prefLabel xml:lang="en">Disclosure of existence of any agreement with employees for representation by EWC, SE Works Council, or SCE Works Council</skos:prefLabel>
    <skos:definition xml:lang="en">Existence of any agreement with employees for representation by a European Works Council (EWC), a Societas Europaea (SE) Works Council, or a Societas Cooperativa Europaea (SCE) Works Council.</skos:definition>
