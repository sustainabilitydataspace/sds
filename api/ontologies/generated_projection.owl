    <skos:prefLabel xml:lang="en">Disclosure of how respect for indigenous peoples' particular rights is taken into account in stakeholder engagement</skos:prefLabel>
    <skos:definition xml:lang="en">Paragraph 23 main respect-rights duty: cultural/intellectual/religious/spiritual property; activities affecting their lands and territories; legislative or administrative measures. This is the respect-rights duty; the consultation 'whether and how' duty is split into whether/how children.</skos:definition>
    <sds:hasUnit rdf:resource="Text"/>
    <sds:hasTemporalGranularity rdf:resource="https://sustainabilitydataspace.com/ontology#Annual"/>
  </rdf:Description>
