    <rdf:type rdf:resource="https://sustainabilitydataspace.com/ontology#Indicator"/>
    <skos:prefLabel xml:lang="en">Scope 3 Category 1 emissions calculated using spend-based method</skos:prefLabel>
    <skos:definition xml:lang="en">CO2e emissions for purchased goods or services calculated by multiplying economic value of goods and services purchased by relevant secondary cradle-to-gate EEIO emission factors and summing across purchased goods or services.</skos:definition>
