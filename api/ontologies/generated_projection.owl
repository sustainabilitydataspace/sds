  <rdf:Description rdf:about="urn:sds:reg:gri:gri_101_7_a_iii">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://sustainabilitydataspace.com/ontology#Indicator"/>
    <skos:prefLabel xml:lang="en">The ecosystem condition for the base year and the current reporting period</skos:prefLabel>
    <skos:definition xml:lang="en">The ecosystem condition for the base year and the current reporting period. Ecosystem condition is the quality of an ecosystem measured by its living and non-living characteristics against a reference condition, including composition, function, structure, landscape characteristics, and physical/chemical state characteristics. Methods to measure ecosystem condition should reflect the relevant characteristics of the ecosystem and may directly measure characteristics or estimate condition based on direct drivers. If the organization monitors the condition at a frequency different from its sustainability reporting frequency, it should report the most recent information and does not need additional measurement to meet the requirement.</skos:definition>
    <sds:hasUnit rdf:resource="Text"/>
    <sds:hasTemporalGranularity rdf:resource="https://sustainabilitydataspace.com/ontology#Annual"/>
  </rdf:Description>
