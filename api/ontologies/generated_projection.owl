  <rdf:Description rdf:about="urn:sds:reg:gri:gri_101_7_a_ii">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://sustainabilitydataspace.com/ontology#Indicator"/>
    <skos:prefLabel xml:lang="en">The ecosystem size in hectares for the base year</skos:prefLabel>
    <skos:definition xml:lang="en">The ecosystem size in hectares for the base year. Ecosystem size, also referred to as ecosystem extent, is the area coverage of the ecosystem that is affected or potentially affected by the organization's activities. This is a fixed area over which the condition of the ecosystem is measured over time.</skos:definition>
    <sds:hasUnit rdf:resource="ha"/>
    <sds:hasTemporalGranularity rdf:resource="https://sustainabilitydataspace.com/ontology#Annual"/>
  </rdf:Description>
