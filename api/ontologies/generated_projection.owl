  <rdf:Description rdf:about="urn:sds:reg:gri:gri_101_5_a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://sustainabilitydataspace.com/ontology#Indicator"/>
    <skos:prefLabel xml:lang="en">Locations of sites with most significant impacts on biodiversity</skos:prefLabel>
    <skos:definition xml:lang="en">Location of sites with the most significant impacts on biodiversity, identified under Disclosure 101-4. The organization should use polygon outlines or maps and, if available, names and coordinates; for transport and fishing activities, departure/arrival locations and FAO major fishing areas/subareas may be reported.</skos:definition>
    <sds:hasUnit rdf:resource="Text"/>
    <sds:hasTemporalGranularity rdf:resource="https://sustainabilitydataspace.com/ontology#Annual"/>
  </rdf:Description>
