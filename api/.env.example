# Public local Docker profile. Generate api/.env with:
#   python scripts/bootstrap_public_env.py
# The generated file is ignored and contains machine-local secrets.
POSTGRES_PASSWORD=
JWT_SECRET_KEY=

REQUIRE_DATABASE=true
SEED_REFERENCE_DATA_ON_STARTUP=true
SEED_DEFAULT_USERS=false
VALUE_REVISION_PRIMARY_READ_PATH=revision
POSTGRES_PORT=5432
ALLOWED_ORIGINS=["http://localhost:8090"]
CORS_ALLOW_CREDENTIALS=false
PORTAL_MOUNT_ENABLED=false
